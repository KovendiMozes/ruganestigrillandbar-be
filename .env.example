# App
NODE_ENV=development
PORT=4000

# CORS — vesszővel elválasztva ha több FE
# QR menu app + admin panel origin-jei
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT
JWT_SECRET=change-me-in-prod-please
JWT_EXPIRES_IN=7d

# Database (Postgres a docker-compose-ból)
POSTGRES_USER=rugonfalva
POSTGRES_PASSWORD=rugonfalva
POSTGRES_DB=rugonfalva
POSTGRES_PORT=5432

DATABASE_URL="postgresql://rugonfalva:rugonfalva@localhost:5432/rugonfalva?schema=public"

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://img.example.com
